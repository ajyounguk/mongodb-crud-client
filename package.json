{
  "name": "mongodb-crud-client",
  "version": "2.0.0",
  "description": "Demo web client exercising MongoDB CRUD operations with Mongoose and Express",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajyounguk/mongodb-crud-client.git"
  },
  "keywords": [
    "mongodb",
    "mongoose",
    "express",
    "crud",
    "demo"
  ],
  "author": "Andrew Young",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ajyounguk/mongodb-crud-client/issues"
  },
  "homepage": "https://github.com/ajyounguk/mongodb-crud-client#readme",
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": "node_modules/.cache/mongodb-binaries"
    }
  },
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "mongoose": "^9.10.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
